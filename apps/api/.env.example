# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Security
# Generate with: openssl rand -hex 32
# Required for authenticated device-sync/device-stats endpoints
# If not set, device endpoints are unauthenticated (backward compat mode)
DEVICE_HMAC_SECRET=
